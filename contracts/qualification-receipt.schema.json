{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ggen-skills qualification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "source_commit", "checks", "standing"],
  "properties": {
    "subject": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "UNSUPPORTED"]},
          "evidence": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "standing": {"enum": ["UNKNOWN", "PARTIAL_ALIVE", "ALIVE", "BLOCKED", "BUILD_BROKEN", "UNSUPPORTED", "REFUSED"]}
  }
}
